				{
					"name": "Register Admin User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Tenant\",\n    \"email\": \"john@acme.com\",\n    \"password\": \"john123\",\n    \"orgName\": \"Acme SaaS Corp\",\n    \"role\": \"ORGANIZATION_ADMIN\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/auth/signup",
