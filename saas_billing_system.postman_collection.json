		{
			"name": "Subscriptions",
			"item": [
				{
					"name": "Initiate Subscription Purchase",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.globals.set(\"pending_payment_id\", jsonData.paymentId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": {{user_id}},\n    \"planId\": 3,\n    \"paymentGateway\": \"STRIPE\",\n    \"currency\": \"USD\",\n    \"billingCycle\": \"monthly\",\n    \"autoRenew\": true,\n    \"isTrial\": false\n}"
						},
